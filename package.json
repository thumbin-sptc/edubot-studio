{
  "name": "edubot-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "EDU-BOT Studio web app for special education teachers",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
